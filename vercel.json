{
  "version": 2,
  "builds": [
    {
      "src": "api/config.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/leads.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/config", "dest": "/api/config.js" },
    { "src": "/api/leads", "dest": "/api/leads.js" },
    { "src": "/script.js", "dest": "/script.js" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/favicon.ico", "dest": "/index.html", "status": 200 },
    { "src": "/favicon.png", "dest": "/index.html", "status": 200 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
